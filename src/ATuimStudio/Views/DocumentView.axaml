<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:ATuimStudio.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="ATuimStudio.Views.DocumentView"
			 x:DataType="vm:DocumentViewModel"
			 xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
			>
	<Design.DataContext>
		<vm:DocumentViewModel />
	</Design.DataContext>
	<Grid RowDefinitions="*,Auto">
		<AvaloniaEdit:TextEditor
			Grid.Row="0"
			x:Name="Editor"
			Document="{Binding FileContent}"
			ShowLineNumbers="True"
			FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
			/>
		<Grid Grid.Row="1">
			<ComboBox x:Name="ZoomSelector" SelectedIndex="3" IsEditable="True" SelectionChanged="ZoomSelected" LosingFocus="ZoomLosingFocus">
				<ComboBoxItem>20 %</ComboBoxItem>
				<ComboBoxItem>50 %</ComboBoxItem>
				<ComboBoxItem>70 %</ComboBoxItem>
				<ComboBoxItem>100 %</ComboBoxItem>
				<ComboBoxItem>150 %</ComboBoxItem>
				<ComboBoxItem>200 %</ComboBoxItem>
				<ComboBoxItem>400 %</ComboBoxItem>
			</ComboBox>
		</Grid>
	</Grid>
</UserControl>
