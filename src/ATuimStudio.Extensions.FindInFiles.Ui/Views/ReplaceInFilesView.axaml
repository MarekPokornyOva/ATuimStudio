<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:ATuimStudio.Extensions.FindInFiles"
		xmlns:ui="using:ATuimStudio.Extensions.FindInFiles"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="ATuimStudio.Extensions.FindInFiles.ReplaceInFilesView"
		x:DataType="vm:ReplaceInFilesViewModel"
		>
	<Design.DataContext>
		<vm:ReplaceInFilesViewModel />
	</Design.DataContext>

	<StackPanel>
		<TextBlock Text="Search text:"/>
		<TextBox Text="{Binding SearchText}" x:Name="tbSearchText"/>
		<TextBlock Text="Replace text:"/>
		<TextBox Text="{Binding ReplaceText}"/>
		<StackPanel Orientation="Horizontal">
			<CheckBox IsChecked="{Binding UseRegex}"/><Label Content="Us_e regular expressions"/>
		</StackPanel>
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Ok" IsDefault="true" Command="{Binding OkCommand}" />
			<Button Content="Cancel" IsCancel="true" Command="{Binding CancelCommand}" />
		</StackPanel>
	</StackPanel>
</UserControl>
