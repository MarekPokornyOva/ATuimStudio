<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:ATuimStudio.Extensions.FindInFiles"
		xmlns:ui="using:ATuimStudio.Extensions.FindInFiles"
		xmlns:commonui="using:ATuimStudio"
		xmlns:common="using:ATuimStudio.Common.Ui"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="ATuimStudio.Extensions.FindInFiles.FindInFilesResultView"
		x:DataType="vm:FindInFilesResultViewModel"
		>
	<Design.DataContext>
		<vm:FindInFilesResultViewModel />
	</Design.DataContext>

	<TableView ItemsSource="{Binding Items}" CanUserResizeColumns="True">
		<Interaction.Behaviors>
			<common:TableViewDoubleClickBehavior Command="{Binding RowDoubleClickCommand}" />
		</Interaction.Behaviors>
		<TableView.Columns>
			<TableViewColumn Header="Code" Binding="{Binding LineText}" Width="*"/>
			<TableViewColumn Header="File" Binding="{Binding FilePath, Converter={x:Static commonui:FilenameConverter.Instance}}" Width="150"/>
			<TableViewColumn Header="Line" Binding="{Binding LineNumber}" HorizontalContentAlignment="Right" Width="50"/>
			<TableViewColumn Header="Column" Binding="{Binding ColumnNumber}" HorizontalContentAlignment="Right" Width="50"/>
		</TableView.Columns>
	</TableView>
</UserControl>
