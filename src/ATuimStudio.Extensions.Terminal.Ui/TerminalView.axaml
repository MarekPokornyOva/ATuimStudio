<UserControl xmlns="https://github.com/avaloniaui"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			xmlns:vm="using:ATuimStudio.Extensions.Terminal"
			mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			x:Class="ATuimStudio.Extensions.Terminal.TerminalView"
			xmlns:terminal="using:Iciclecreek.Terminal"
			x:DataType="vm:TerminalViewModel"
			>
	<Design.DataContext>
		<vm:TerminalViewModel />
	</Design.DataContext>

	<terminal:TerminalControl x:Name="Terminal" StartingDirectory="{Binding SolutionDirectory}" />
</UserControl>
